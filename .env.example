# ──────────────────────────────────────────────────────────────────────────────
# SmartCheck — Environment Variables
# Copy this file to .env and fill in the values before running the app.
# Never commit your actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Flask secret key — used to sign session cookies and CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to "production" to enable production-mode guards (secure cookies, strict env checks).
# Leave unset or set to "development" for local dev.
FLASK_ENV=development

# Set to "0" to disable the Flask reloader/debugger (alternative to FLASK_ENV=production).
FLASK_DEBUG=1

# ── Supabase ───────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase anonymous/public key — used for RLS-enforced client operations.
SUPABASE_ANON_KEY=

# Supabase service role key — bypasses RLS, used only for admin/server operations.
# Keep this secret — never expose to the browser.
SUPABASE_SERVICE_KEY=

# ── Database ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string for Flask-Session (SQLAlchemy backend).
# On Railway this is set automatically. For local dev use your Supabase direct URL:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# ── Security ───────────────────────────────────────────────────────────────────

# Random salt used to compute SHA-256 integrity hashes over stored face embeddings.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EMBEDDING_INTEGRITY_SALT=

# ESP32: set the exact plain ASCII firmware secret (no Base32 decoding).
# A mismatch makes every code fail and can look like a verifier logic bug.
ESP32_TOTP_SECRET=
# Explicit console demo mode; never bypasses verification.
ESP32_TOTP_SIMULATOR=false

# ── Rate Limiting ──────────────────────────────────────────────────────────────

# Redis connection URL for Flask-Limiter (e.g. redis://localhost:6379/0).
# Leave empty to fall back to in-memory limiting (single-process only).
REDIS_URL=

# Number of reverse proxies in front of Flask whose X-Forwarded-For/-Proto are
# trusted. 1 behind cloudflared (or one nginx); 0 (default) when clients connect
# directly — then the header is ignored because any client could forge it.
TRUSTED_PROXY_HOPS=

# Check-in proximity: ble (default, ESP32 signs a server nonce) or totp (room code)
CHECKIN_PROXIMITY_METHOD=ble

# Required independent signing secret: generate with secrets.token_hex(32)
PROXIMITY_RECEIPT_SECRET=
# Performance rollout: see docs/review/12-enrollment-status-performance.md
PERFORMANCE_LOG_ENABLED=false
ENROLLMENT_STATUS_CACHE=true
# Apply database/migrations/20260919_enrollment_status.sql before enabling.
ENROLLMENT_STATUS_RPC=false

# Face stack v2 (InsightFace buffalo_l; DeepFace/TensorFlow removed). Needs
# database/migrations/20261019_face_stack_v2.sql. The four settings below are
# required and have no defaults: choose them from your own photos with
# scripts/compare_models.py. The app refuses to start without them.
FACE_ENGINE=arcface
# on | off — CLAHE before detection, same at enrollment and check-in
FACE_CLAHE=
# cosine; check-in match / 1:N duplicate block / enrollment frontal self-consistency
ARCFACE_MATCH_THRESHOLD=
ARCFACE_DUP_THRESHOLD=
ENROLL_SELF_SIM_MIN=
# 1 = load and run the face models once at startup (logs the warm-up time)
FACE_ENGINE_WARMUP=1
# Check-in liveness: passive (capture only, anti-spoof decides) or head_turn
CHECKIN_LIVENESS=passive

# LINE Beacon proximity (optional; docs/line_beacon.md). Needs migration
# 20261020_line_beacon.sql, a LINE Official Account with Messaging API, and a
# fixed https URL. Webhook URL to set in LINE Developers: <PUBLIC_BASE_URL>/line/webhook
LINE_BEACON_ENABLED=0
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PUBLIC_BASE_URL=
